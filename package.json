{
  "name": "kingdom-factor-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "description": "Kingdom Factor Astro + EmDash CMS site for Cloudflare Workers.",
  "emdash": {
    "label": "Kingdom Factor Website",
    "seed": "seed/seed.json",
    "adminPath": "/_emdash/admin",
    "status": "runtime wired for Cloudflare; admin at /_emdash/admin"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "verify": "npm run verify:legal && npm run build && npm run typecheck && npm run emdash:seed:validate",
    "verify:legal": "node scripts/verify-legal-policies.mjs",
    "qa:legal": "node scripts/qa-legal-policies.mjs",
    "emdash:note": "node -e \"console.log('EmDash runtime is enabled for Cloudflare Workers. Production requires the configured D1, R2, and KV bindings; deployment remains approval-gated.')\"",
    "tailwind:note": "node -e \"console.log('Tailwind token direction is captured in DESIGN.md; current verified build uses authored CSS to avoid Vite/Rolldown plugin mismatch in Railway.')\"",
    "emdash:seed:validate": "emdash seed seed/seed.json --validate --database ./.emdash/kingdom-factor.db",
    "emdash:seed:local": "emdash seed seed/seed.json --database ./.emdash/kingdom-factor.db --on-conflict update"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.5.0",
    "@astrojs/react": "^5.0.4",
    "@cloudflare/workers-types": "^4.20260510.1",
    "@emdash-cms/cloudflare": "^0.10.0",
    "astro": "^6.0.1",
    "emdash": "^0.10.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "wrangler": "^4.90.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "esbuild-wasm": "^0.28.0",
    "impeccable": "^2.1.8",
    "playwright": "^1.59.1",
    "puppeteer": "^24.43.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "frontendRuntimeDependencies": {
    "tailwindcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2"
  },
  "optionalRuntimeDependencies": {
    "cloudflareWorkersPages": {
      "@astrojs/cloudflare": "^13.1.7",
      "wrangler": "^4.80.0",
      "@cloudflare/workers-types": "^4.20260305.1"
    },
    "emdashCmsIfApproved": {
      "@emdash-cms/cloudflare": "^0.6.0",
      "emdash": "^0.6.0"
    },
    "convexIfBackendNeeded": {
      "convex": "latest"
    }
  }
}
