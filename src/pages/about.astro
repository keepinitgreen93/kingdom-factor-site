---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import Schema from "../components/Schema.astro";
import { people } from "../lib/site";

const emailSignupForm = "https://api.leadconnectorhq.com/widget/form/PH3XIjJVSBiIqjdVGylp";
---
<Base title="About" description="Purpose Driven Consulting, LLC and Kingdom Factor have partnered to bring peer advisory, executive coaching, and marketplace ministry consulting together for Christian business leaders." canonical="/about/">
  <Schema type="WebPage" title="About Purpose Driven Consulting, LLC and Kingdom Factor" description="Purpose Driven Consulting, LLC and Kingdom Factor have partnered to bring peer advisory, executive coaching, and marketplace ministry consulting together for Christian business leaders." path="/about/" breadcrumbs={[{ name: "Home", item: "/" }, { name: "About", item: "/about/" }]} />
  <PageHero eyebrow="About Purpose Driven Consulting, LLC and Kingdom Factor" title="A partnership for owners and leaders building more than a business." text="Purpose Driven Consulting, LLC and Kingdom Factor have partnered to help Christian business owners and leaders make better decisions, grow with wisdom, and lead in alignment with faith, calling, stewardship, and practical counsel." primary={{ label: "Choose your path", href: "/#paths" }} secondary={{ label: "Contact our team", href: "/contact/" }} />

  <section class="partnership">
    <div class="partnership-inner">
      <p class="eyebrow">Our partnership</p>
      <h2>Our Strategic Partnership with Kingdom Factor</h2>
      <p>At Purpose Driven Consulting, LLC, we believe that collaboration is essential to meaningful and lasting impact. That conviction is at the heart of our strategic partnership with Kingdom Factor, a global movement equipping Christian business leaders to align their leadership, culture, and strategy with God's calling in the marketplace.</p>
      <p>Purpose Driven Consulting, LLC was founded on a passion for helping leaders succeed through personalized, results-driven coaching and consulting. Today, that same commitment continues as we come alongside leaders to empower purpose, inspire growth, and cultivate thriving organizations. Through our partnership with Kingdom Factor, we extend that mission by integrating biblically grounded leadership with proven business practices.</p>
      <p>As Kingdom Factor Certified Coaches, Dr. John Lybarger and James "Jim" Lybarger offer two peer advisory groups: one for Christian owners and executives, and one for emerging owners, solopreneurs, startup founders, and small-business leaders.</p>
      <p>A core expression of this partnership is facilitating Kingdom Factor Peer Advisory Groups, confidential, member-driven cohorts of 8 to 12 Christian business leaders. These groups meet regularly to engage in real conversations about real challenges, producing real results. By combining best-in-class business practices with Kingdom Factor's Operating System and Christ-centered leadership content, each group functions as a trusted personal board of advisors. Members gain sharper decision-making, consistent accountability, strategic insight, and the support of prayer, ensuring they no longer have to lead in isolation.</p>
      <p>In addition to peer advisory groups, Purpose Driven Consulting, LLC offers one-on-one executive and leadership coaching. These engagements integrate organizational psychology, decades of business experience, and Spirit-led discernment to help leaders clarify their calling, navigate complexity, and build healthy, high-performing organizations. Coaching focuses on purpose and calling, strategic execution, organizational culture, team health, and personal and spiritual resilience.</p>
      <p>Together, Purpose Driven Consulting, LLC and Kingdom Factor equip leaders to thrive at the intersection of faith, business, and family, leading with clarity, conviction, and Kingdom impact.</p>
    </div>
  </section>

  <section class="content-section">
    <div class="content-grid values-grid">
      <article class="content-card"><span class="card-number">01</span><h2>Vision</h2><p>To cultivate a world where leaders build trust, grow through relationships, lead with reflection, and multiply their influence for the good of organizations, communities, and future generations.</p></article>
      <article class="content-card"><span class="card-number">02</span><h2>Mission</h2><p>We equip leaders to build trust, cultivate meaningful relationships, practice intentional reflection, and multiply healthy leadership through peer advisory, coaching, consulting, speaking, and transformational learning experiences.</p></article>
      <article class="content-card"><span class="card-number">03</span><h2>Brand Promise</h2><p>Building Trust. Growing Leaders. Multiplying Impact.</p></article>
      <article class="content-card"><span class="card-number">04</span><h2>Guiding Philosophy</h2><p>Leadership flourishes where trust is built, relationships are cultivated, reflection is practiced, and leaders intentionally multiply others.</p><ul class="check-list"><li>Trust is the foundation.</li><li>Relationships are the context.</li><li>Reflection is the discipline.</li><li>Multiplication is the legacy.</li></ul></article>
    </div>
  </section>
  <section class="people-section">
    <div class="section-header center"><p class="eyebrow">Leadership lanes</p><h2>Two guides. Two audiences. One Kingdom Factor platform.</h2></div>
    <div class="two-column">
      {people.map((person) => (
        <article class="person-card">
          <img class="person-portrait" src={person.image} alt={person.name} loading="lazy" />
          <h3>{person.name}</h3>
          <p>{person.summary}</p>
          <a class="text-link" href={person.href}>View pathway →</a>
        </article>
      ))}
    </div>
  </section>
  <section class="partnership statement-of-faith">
    <div class="partnership-inner">
      <p class="eyebrow">Statement of faith</p>
      <h2>Kingdom Factor Statement of Faith</h2>
      <p>We believe that the Bible is God's written revelation to mankind, and that it is verbally inspired, authoritative, and without error in the original manuscripts.</p>
      <p>We believe in the deity of Jesus Christ; His virgin birth; sinless life; miracles; death on the cross to provide for our redemption; bodily resurrection; ascension into heaven; present ministry of intercession for us; and His future return to earth in power and glory.</p>
      <p>We believe that mankind was created in the image of God, but because of sin, was alienated from God. Only through faith, trusting in Christ alone for salvation, which was made possible by His death and resurrection, can that alienation be removed.</p>
    </div>
  </section>
  <CTA signupFormUrl={emailSignupForm} />
</Base>

<style>
  .partnership {
    background: rgba(255, 250, 242, 0.62);
    padding: clamp(2.75rem, 5vw, 4.5rem) clamp(1rem, 4vw, 2rem);
  }
  .partnership-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .partnership h2 {
    font-size: clamp(2.05rem, 3.6vw, 3.1rem);
    text-wrap: balance;
    margin-bottom: 1.1rem;
  }
  .partnership p {
    font-size: clamp(1.04rem, 1.2vw, 1.16rem);
    line-height: 1.72;
    color: #4d423b;
    margin-bottom: 1rem;
  }
  .values-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1080px) { .values-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .values-grid { grid-template-columns: 1fr; } }
</style>
