---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import Schema from "../components/Schema.astro";

type BookEntry = { title: string; subtitle?: string; url?: string | null; linkLabel?: string };
type BookGroup = { category: string; books: BookEntry[] };

const johnAuthorPage = "https://johnlybargerbooks.com/";
const emailSignupForm = "https://api.leadconnectorhq.com/widget/form/PH3XIjJVSBiIqjdVGylp";

const johnBookGroups: BookGroup[] = [
  {
    category: "Faith-based leadership",
    books: [
      { title: "Stop Leading Alone", subtitle: "Real Conversations. Real Support. Real Leadership Growth.", url: "https://www.amazon.com/dp/B0GZBH8M19", linkLabel: "View this book -->" },
      { title: "The Leadership Circle: Peer Advisory Groups: A Christian Leader's Guide to Accountability, Authentic Connection, and Spiritual Growth", url: "https://www.amazon.com/dp/B0GQNS8Q4W" },
      { title: "Marketplace Ministry: The Christian Leader's Guidebook for Building a Kingdom Business", url: "https://www.amazon.com/dp/B0G45WDJL8" },
      { title: "Lead Like Jesus: A Biblical Blueprint for Servant Leadership Excellence", url: "https://www.amazon.com/dp/B0GM8VMQ3P" },
      { title: "Biblical Accountability: A Practical Guide for Creating an Accountability Culture and Instilling Trust in Ministries", url: "https://www.amazon.com/dp/B0GFY35SHH" },
      { title: "Relational Intelligence for Church Leaders: Practical Wisdom from Paul's Letters for Christian Leadership, Team Building, and Ministry Growth", url: "https://www.amazon.com/dp/B0GD2S7FWM" },
      { title: "From Wounds to Wisdom: A Faith-Based Framework for Post-Traumatic Growth and Pastoral Coaching", url: "https://www.amazon.com/dp/B0G4XS4ST9" },
      { title: "Rebuilding Life Beyond: From Potential to Presence: A Practical Guide for Christian Coaches and Spiritual Directors—Bridging Church, Community, Contemporary Life, and Digital Realities", url: "https://www.amazon.com/dp/B0G45NJ6Q8" },
      { title: "Rebuilding Life Beyond: Creating Connection and Belonging in a Lonely World: A Biblical Guide for Creating Relationship, Fellowship, Stewardship, Leadership, Discipleship, and Worship", url: "https://www.amazon.com/dp/B0G45NKTVS" },
      { title: "Rebuilding Life Beyond: Discipleship in Community: A Step-By-Step Guide for Small Group Leaders", url: "https://www.amazon.com/dp/B0FP46DP7H" },
      { title: "Rebuilding Life Beyond: Forgiving Oneself and Moving Forward with a Renewed Sense of Purpose: A Practical Christian Guide for Breaking Free from Guilt, Shame, Resentment, and Unforgiveness", url: "https://www.amazon.com/dp/B0G45K2QN7" },
      { title: "Rebuilding Life Beyond: From Hurt to Hope—Rebuilding Relationships in Your Church: A Pastor's Guide to Emotional Intelligence as a Leadership Skill—Cultivating Self-Awareness and Conflict Resolution", url: "https://www.amazon.com/dp/B0G45JCQNQ" },
    ],
  },
  {
    category: "Leadership",
    books: [
      { title: "Relational Intelligence: The Leader's Guide to Building High-Trust, High-Performance Teams", url: "https://www.amazon.com/dp/B0GDRVN3T5" },
      { title: "The Resilient Team: A Leader's Guide to Building Psychological Safety and Holistic Well-Being at Work", url: "https://www.amazon.com/dp/B0GDGFSCT7" },
      { title: "Speaking the Language of Change: A Leader's Guide to Powerful Dialogue and Collective Action", url: "https://www.amazon.com/dp/B0GDCPGGTG" },
      { title: "Leading with Purpose: The Small Business Management Playbook", url: "https://www.amazon.com/dp/B0GCL65GXB" },
      { title: "The Small Business Learning Revolution: A Field Guide to Talent Development in the Digital Age", url: "https://www.amazon.com/dp/B0GD4RM3VN" },
      { title: "Leading Change One Conversation at a Time: How to Coach Individuals and Teams Through Transformation", url: "https://www.amazon.com/dp/B0GC7XSXYQ" },
      { title: "The Coaching Skills Playbook: A Practical Guide for Supervisors, Managers, and Executives to Develop People, Potential, and Careers", url: "https://www.amazon.com/dp/B0G5MNKVXM" },
      { title: "The Peer Coach's Handbook: Aligning Leaders Through Collaborative Learning", url: "https://www.amazon.com/dp/B0G4SVB9LV" },
      { title: "Managing Organizational Conflict: Turning Tension into Trust and Collaboration", url: "https://www.amazon.com/dp/B0G6JRZQ26" },
      { title: "From Navigator to Mapmaker: Leading Your Organization's Future Journey: How to Stop Managing Daily Crises and Start Building Systems That Lead Themselves", url: "https://www.amazon.com/dp/B0G69WTK2V" },
      { title: "Beyond Boundaries: The Essential Guide to Spanning Siloes and Unifying Your Organization", url: "https://www.amazon.com/dp/B0G4BRYZHB" },
      { title: "Critical Self-Reflection in Coaching: A Practitioner's Guide to Professional Development and Client Learning", url: "https://www.amazon.com/dp/B0GR8L4P96" },
      { title: "The Shadow Side of Emotional Intelligence: From Self-Awareness to Control and Boundary Violations: The Manipulative Power of Emotional Intelligence in Toxic Relationships", url: "https://www.amazon.com/dp/B0FNKVCCHN" },
    ],
  },
  {
    category: "Self-help",
    books: [
      { title: "Rebuilding Life Beyond: Anxiety Relief and Confidence Building for Adults: A Self-Help Guide to Overcoming Fear of Failure and Overthinking", url: "https://www.amazon.com/dp/B0G4644VSB" },
      { title: "Rebuilding Life Beyond: Recovery From Losing Your Job: A Practical Guide for Finding Your Purpose, Passion, and Path Leading to Your Ideal Career", url: "https://www.amazon.com/dp/B0FT213VHW" },
      { title: "Rebuilding Life Beyond: Managing Narcissistic Relationships: A Practical Guide for Healing, Recovery, and Emotional Freedom After Narcissistic Abuse", url: "https://www.amazon.com/dp/B0G45KJ9HD" },
      { title: "Rebuilding Life Beyond: Managing Dementia Caregiving for Family Members: A Practical Guide to Navigate Alzheimer's, Self-Care, Emotional Support, and Building Resilience with Compassion and Coping", url: "https://www.amazon.com/dp/B0G45NJ4DX" },
    ],
  },
];

const jimBooks: BookEntry[] = [
  { title: "Stop Leading Alone", subtitle: "Real Conversations. Real Support. Real Leadership Growth.", url: "https://www.amazon.com/dp/B0GZBH8M19", linkLabel: "View this book -->" },
  { title: "Rise in Peer Community", subtitle: "Soar Together as Christian Leaders", url: "https://www.amazon.com/dp/B0GX5CL9T3" },
  { title: "The Story You're Living", subtitle: "A Step-by-Step Guide to Matching Your Life With Your Deepest Values", url: "https://www.amazon.com/dp/B0GXV6RDXK" },
  { title: "Soar Like an Eagle", subtitle: "Finding Meaning and Confidence Through Life's Struggles", url: "https://www.amazon.com/dp/B0GLLVZ381" },
];
---
<Base title="Books by Dr. John S. Lybarger and Jim Lybarger" description="Published books from Dr. John S. Lybarger and Jim Lybarger on Christian leadership, marketplace ministry, peer advisory, coaching, culture, and stewardship." canonical="/books/">
  <Schema type="WebPage" title="Books by Dr. John S. Lybarger and Jim Lybarger" description="Published books from Dr. John S. Lybarger and Jim Lybarger on Christian leadership, marketplace ministry, peer advisory, coaching, culture, and stewardship." path="/books/" breadcrumbs={[{ name: "Home", item: "/" }, { name: "Books", item: "/books/" }]} />
  <PageHero
    eyebrow="Books by Dr. John S. Lybarger and Jim Lybarger"
    title="Practical wisdom for Christian owners and executives."
    text="Decades of leadership wisdom in print — covering peer advisory, marketplace ministry, executive coaching, culture, biblical accountability, conflict, change, and Christ-centered leadership. Each title links out to its publisher or retailer."
    primary={{ label: "Request a fit conversation", href: "/apply/" }}
    secondary={{ label: "Explore marketplace ministry", href: "/marketplace-ministry/" }}
  />

  <section class="content-section books-section books-section--lead">
    <div class="section-header">
      <p class="eyebrow">Dr. John S. Lybarger</p>
      <h2>Books by Dr. Lybarger</h2>
      <p>Dr. Lybarger's books span peer advisory, marketplace ministry, executive coaching, biblical accountability, organizational change, and Christ-centered leadership development.</p>
      <a class="author-page-link" href={johnAuthorPage} target="_blank" rel="noopener">See Dr. Lybarger's author page →</a>
    </div>

    <aside class="email-signup" aria-labelledby="email-signup-title">
      <div class="email-signup-copy">
        <p class="eyebrow">Stay connected</p>
        <h3 id="email-signup-title">Get leadership insights by email</h3>
        <p>Sign up for news, practical guidance, and updates from Dr. Lybarger and Purpose Driven Consulting.</p>
      </div>
      <iframe
        src={emailSignupForm}
        title="Sign up for email updates from Purpose Driven Consulting"
        class="email-signup-frame"
        loading="lazy"
      ></iframe>
    </aside>

    {johnBookGroups.map((group) => (
      <div class="book-group">
        <h3 class="book-group-title">{group.category}</h3>
        <div class="books-grid">
          {group.books.map((book) => (
            <article class="book-card">
              <h3>{book.title}</h3>
              {book.subtitle && <p class="book-subtitle">{book.subtitle}</p>}
              {book.url ? (
                <a class="book-link" href={book.url} target="_blank" rel="noopener">{book.linkLabel ?? "View this book →"}</a>
              ) : (
                <span class="book-link book-link-pending">Purchase link coming soon</span>
              )}
            </article>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="content-section books-section">
    <div class="section-header">
      <p class="eyebrow">James C. "Jim" Lybarger</p>
      <h2>Books by Jim Lybarger</h2>
      <p>Jim's work supports emerging owners, founders, and Christian professionals walking through transition, identity, and second-chance leadership.</p>
    </div>
    <div class="books-grid">
      {jimBooks.map((book) => (
        <article class="book-card">
          <h3>{book.title}</h3>
          {book.subtitle && <p class="book-subtitle">{book.subtitle}</p>}
          {book.url ? (
            <a class="book-link" href={book.url} target="_blank" rel="noopener">{book.linkLabel ?? "View this book →"}</a>
          ) : (
            <span class="book-link book-link-pending">Purchase link coming soon</span>
          )}
        </article>
      ))}
    </div>
  </section>

  <CTA />
</Base>

<style>
  .books-section {
    padding-top: clamp(3rem, 5.5vw, 5rem);
    padding-bottom: clamp(3rem, 5.5vw, 5rem);
  }
  :global(.page-hero:has(+ .books-section--lead)) {
    padding-top: clamp(3.25rem, 5vw, 4.6rem) !important;
    padding-bottom: clamp(1rem, 1.7vw, 1.5rem) !important;
  }
  :global(.page-hero:has(+ .books-section--lead) .photo-hero-card) {
    min-height: clamp(320px, 26vw, 400px);
  }
  .books-section--lead {
    padding-top: clamp(1rem, 2vw, 1.75rem);
  }
  :global(.js-reveal-ready .books-section--lead.kf-reveal),
  :global(.js-reveal-ready .books-section--lead .section-header.kf-reveal) {
    opacity: 1 !important;
    transform: none !important;
  }
  .books-section .section-header {
    max-width: 820px;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    text-align: center;
  }
  .books-section .section-header h2 {
    font-size: clamp(2.1rem, 3.6vw, 3.2rem);
    text-wrap: balance;
  }
  .author-page-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--burgundy, #641f24);
    text-decoration: none;
    border-bottom: 1px solid rgba(100, 31, 36, 0.32);
    padding-bottom: 1px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .author-page-link:hover {
    color: var(--burgundy-dark, #4a0f15);
    border-color: rgba(100, 31, 36, 0.7);
  }
  .email-signup {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1.15fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    max-width: min(1080px, calc(100% - clamp(2rem, 8vw, 4rem)));
    margin: 0 auto clamp(3rem, 5vw, 4.5rem);
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    background: linear-gradient(135deg, rgba(255, 250, 242, 0.98), rgba(246, 238, 225, 0.92));
    border: 1px solid rgba(168, 148, 131, 0.38);
    border-radius: 28px;
    box-shadow: 0 24px 60px rgba(74, 15, 21, 0.08);
  }
  .email-signup-copy h3 {
    margin: 0.4rem 0 0.75rem;
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(1.65rem, 2.7vw, 2.35rem);
    line-height: 1.15;
    color: var(--burgundy-dark, #4a0f15);
    text-wrap: balance;
  }
  .email-signup-copy > p:last-child {
    margin: 0;
    color: rgba(81, 70, 63, 0.9);
    text-wrap: pretty;
  }
  .email-signup-frame {
    display: block;
    width: 100%;
    height: 920px;
    border: 0;
    border-radius: 18px;
    background: #fff;
  }
  .book-group {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }
  .book-group + .book-group {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
  }
  .book-group-title {
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    color: var(--burgundy-dark, #4a0f15);
    margin: 0 0 clamp(1rem, 2vw, 1.4rem);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(168, 148, 131, 0.4);
    letter-spacing: -0.01em;
  }
  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }
  .book-group .books-grid {
    padding: 0;
  }
  .book-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 2.2vw, 1.65rem);
    background: rgba(255, 250, 242, 0.7);
    border: 1px solid rgba(168, 148, 131, 0.32);
    border-radius: 22px;
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.32s ease, border-color 0.32s ease;
    min-height: 200px;
  }
  .book-card:hover {
    transform: translateY(-3px);
    border-color: rgba(100, 31, 36, 0.45);
    box-shadow: 0 18px 40px rgba(100, 31, 36, 0.12);
  }
  .book-card h3 {
    font-size: clamp(1.05rem, 1.3vw, 1.18rem);
    line-height: 1.32;
    color: var(--burgundy-dark, #4a0f15);
    text-wrap: balance;
    max-width: 30ch;
  }
  .book-subtitle {
    margin-top: -0.35rem;
    font-size: 0.92rem;
    line-height: 1.4;
    color: rgba(81, 70, 63, 0.85);
    font-style: italic;
    text-wrap: pretty;
  }
  .book-link {
    display: inline-block;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--burgundy, #641f24);
    text-decoration: none;
    letter-spacing: 0.01em;
    padding-top: 0.4rem;
    border-top: 1px solid rgba(168, 148, 131, 0.32);
  }
  .book-link:hover {
    color: var(--burgundy-dark, #4a0f15);
  }
  .book-link-pending {
    color: rgba(81, 70, 63, 0.62);
    font-weight: 500;
    font-style: italic;
    cursor: default;
  }
  @media (max-width: 760px) {
    .email-signup {
      grid-template-columns: 1fr;
      max-width: 100%;
      padding: 1.25rem;
      border-radius: 22px;
    }
    .email-signup-frame { height: 1020px; }
    .book-group, .books-grid { width: 100%; max-width: 100%; padding-inline: 0; }
    .book-card { width: 100%; max-width: none; min-height: 0; }
    .book-card h3 { font-size: 1.02rem; line-height: 1.42; max-width: 100%; letter-spacing: -0.005em; }
    .books-section .section-header { width: 100%; max-width: 100%; padding-inline: 0; text-align: left; }
  }
</style>
