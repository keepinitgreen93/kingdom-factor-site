---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CTA from "../components/CTA.astro";
import Schema from "../components/Schema.astro";
import { bookHighlights } from "../lib/site";
const johnBooks = [
  "The Leadership Circle: Peer Advisory Groups — A Christian Leader's Guide to Accountability, Authentic Connections, Action, and Spiritual Growth",
  "Marketplace Ministry: The Christian Leader's Guidebook for Building a Kingdom Business",
  "Lead Like Jesus: A Biblical Blueprint for Spiritual Servant Leadership Excellence",
  "Biblical Accountability: A Practical Guide for Creating an Accountability Culture and Instilling Trust in Ministries",
  "Relational Intelligence: The Leader's Guide to Building High-Trust, High-Performance Teams",
  "The Resilient Team: A Leader's Guide to Building Psychological Safety and Holistic Well-Being at Work",
  "Speaking the Language of Change: A Leader's Guide to Powerful Dialogue and Collective Action",
  "The Small Business Learning Revolution: A Field Guide to Talent Development in the Digital Age",
  "Leading with Purpose: The Small Business Management Playbook",
  "Leading Change One Conversation at a Time: How to Coach Individuals and Teams Through Transformation",
  "The Coaching Skills Playbook: A Practical Guide for Supervisors, Managers, and Executives to Develop People, Potential, and Careers",
  "The Peer Coaches Handbook: Aligning Leaders Through Collaborative Learning",
  "Managing Organizational Conflict: Turning Tension into Trust and Collaboration",
  "From Navigator to Mapmaker: Leading Your Organization's Future Journey — How to Stop Managing Daily Crises, and Start Building Systems that Lead Themselves",
  "Beyond Boundaries: The Essential Guide to Spanning Silos and Unifying Your Organization",
];
const jimBooks = ["Rise in Peer Community", "The Story You're Living", "Soar Like an Eagle"];
---
<Base title="Books & Resources" description="Kingdom Factor books, author resources, webinar material, and source-backed pathways for Christian business leaders." canonical="/books/">
  <Schema type="WebPage" title="Books & Resources" description="Kingdom Factor books, author resources, webinar material, and source-backed pathways for Christian business leaders." path="/books/" breadcrumbs={[{ name: "Home", item: "/" }, { name: "Books & Resources", item: "/books/" }]} />
  <PageHero eyebrow="Books and resources" title="Practical wisdom for Christian owners and executives seeking to expand their marketplace ministry." text="Kingdom Factor resources equip leaders to think with greater clarity about stewardship, culture, accountability, peer advisory, and the decisions that shape faithful servant leadership." primary={{ label: "Explore Marketplace Ministry", href: "/marketplace-ministry/" }} secondary={{ label: "Request a fit conversation", href: "/apply/" }} />
  <section class="content-section">
    <div class="two-column">
      <article class="content-card">
        <span class="card-number">John</span>
        <h2>Dr. Lybarger's Books</h2>
        <p>Use approved books to support the executive coaching, peer advisory, biblical accountability, conflict, leadership, coaching, and marketplace ministry lanes.</p>
        <ul class="check-list">{johnBooks.map((item) => <li>{item}</li>)}</ul>
      </article>
      <article class="content-card">
        <span class="card-number">Jim</span>
        <h2>Jim Lybarger's Books</h2>
        <p>Use Jim's books to support the emerging-owner path around story, values, identity, peer community, and meaning-driven leadership.</p>
        <ul class="check-list">{jimBooks.map((item) => <li>{item}</li>)}</ul>
      </article>
    </div>
  </section>
  <section class="authority-section compact">
    <div class="authority-copy"><p class="eyebrow">Lead magnet candidates</p><h2>Turn source material into useful first steps.</h2><p>Recommended candidates: readiness assessment, Leadership Circle briefing, Marketplace Ministry resource, peer advisory fit checklist, or a permissioned book chapter/reading guide.</p></div>
    <div class="book-cloud">{bookHighlights.map((book) => <span>{book}</span>)}</div>
  </section>
  <CTA />
</Base>
