---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Schema from "../components/Schema.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { offers, pillars, people, bookHighlights, seoOpportunities } from "../lib/site";
---
<Base title="Kingdom Factor" description="A trusted advisory circle for Christian business owners who want to lead with wisdom, faith, and accountability.">
  <Schema />
  <section class="home-brand-masthead" aria-label="Purpose Driven Consulting and Kingdom Factor">
    <img
      src="/images/brand/pdc-kf-lead-better-together-banner.png"
      alt="Dr. John S. Lybarger and James Jim C. Lybarger with the Purpose Driven Consulting and Kingdom Factor logos and the message Lead Better Together"
      width="1774"
      height="887"
      fetchpriority="high"
    />
  </section>
  <section class="home-hero polished-hero executive-hero editorial-hero">
    <div class="hero-copy editorial-hero-copy">
      <p class="eyebrow">Private counsel for Christian CEOs, owners, and senior leaders</p>
      <h1>Ensure you're in the room where wisdom surrounds you.</h1>
      <p>Purpose Driven Consulting, LLC and Kingdom Factor have partnered to help faith-driven Christian business owners and leaders process high-stakes decisions with qualified peers, executive coaching, and biblical wisdom and consulting around growth, culture, stewardship, and leadership pressures.</p>
      <div class="actions hero-actions">
        <a class="btn btn-primary" href="/apply/">Request a fit conversation</a>
        <a class="btn btn-secondary" href="/peer-advisory-groups/">See the advisory path</a>
      </div>
    </div>
  </section>

  <section class="decision-room-section" aria-label="Kingdom Factor advisory setting">
    <div class="decision-room-copy">
      <p class="eyebrow">What changes in the room</p>
      <h2>The conversation moves from encouragement to wise counsel, action, and accountability.</h2>
    </div>
    <div class="decision-room-lines">
      <p><strong>Isolation gets named.</strong> Christian business owners and leaders can speak plainly about decisions that affect people, money, culture, family, faith, and the future of the business.</p>
      <p><strong>Blind spots get challenged.</strong> Qualified peers and seasoned advisors help pressure-test the next move before it becomes expensive.</p>
      <p><strong>Stewardship becomes practical.</strong> The point is not inspiration. The point is wiser decisions, faithful execution, and clear next steps.</p>
    </div>
  </section>

  <section class="council-model-section model-section">
    <div class="council-model-intro">
      <p class="eyebrow">The Purpose Driven Consulting, LLC Model</p>
      <h2>Four lanes, one purpose: do not lead alone.</h2>
      <p>Peer advisory, Kingdom Culture Intensive, executive coaching, and marketplace ministry consulting form a practical path from leader isolation into qualified counsel.</p>
    </div>
    <div class="council-model-list">
      {pillars.map((pillar, index) => (
        <article class="council-lane">
          <span>0{index + 1}</span>
          <div>
            <h3>{pillar.title}</h3>
            <p>{pillar.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="paths" class="lane-section">
    <SectionHeader eyebrow="Choose your path" title="Built for established executives and emerging owners in different seasons." text="The right next step depends on the weight of your decisions, the maturity of your business, and the kind of counsel you need now." align="center" />
    <div class="lane-grid">
      {people.map((person) => (
        <article class={`lane-card leader-lane ${person.lane === "Executive advisory" ? "executive" : "community"}`}>
          <img class="leader-portrait" src={person.image} alt={person.name} loading="lazy" />
          <h3>{person.name}</h3>
          <p>{person.summary}</p>
          <a class="text-link" href={person.href}>Explore this pathway →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="offer-section pathway-section">
    <SectionHeader eyebrow="Offer ecosystem" title="Move from curiosity to a qualified conversation." text="Resources and preview paths help leaders understand the model before they request a fit conversation or apply for a room." align="center" />
    <div class="offer-grid pathway-grid">
      {offers.map((offer) => (
        <article class="offer-card premium-card">
          <p>{offer.audience}</p>
          <h3>{offer.title}</h3>
          <p>{offer.summary}</p>
          <a href={offer.href}>View pathway →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="authority-section">
    <div class="authority-copy">
      <p class="eyebrow">Books and resources</p>
      <h2>The wisdom behind the room, available to you in print.</h2>
      <p>Brothers, Dr. John and Jim Lybarger have written widely on accountability, marketplace ministry, leadership development, and faithful execution. Explore their books to engage the ideas that shape every conversation and work through the questions you are already carrying, long before your first call.</p>
      <a class="btn btn-secondary" href="/books/">View books and resources</a>
    </div>
    <div class="image-feature-card motion-card">
      <picture>
        <source media="(max-width: 640px)" srcset="/images/generated/leadership-table-mobile.webp" />
        <img src="/images/generated/leadership-table-1440.webp" alt="Leadership table with warm executive counsel materials" loading="lazy" />
      </picture>
      <div class="book-cloud overlay-cloud">
        {bookHighlights.slice(0, 6).map((book) => <span>{book}</span>)}
      </div>
    </div>
  </section>

  <section class="seo-section">
    <SectionHeader eyebrow="Leadership topics" title="Built around the questions Christian owners are already carrying." text="The resource path can grow into practical guides for faith-and-business leadership, peer counsel, accountability, and stewardship." align="center" />
    <div class="keyword-grid">
      {seoOpportunities.map((keyword) => <span>{keyword}</span>)}
    </div>
  </section>

  <section class="source-section story-section">
    <div class="source-panel story-panel">
      <p class="eyebrow">Kingdom Factor Collective</p>
      <h2>Real stories help leaders see faithful business in practice.</h2>
      <p>The Collective gives Christian owners a place to learn from grounded conversations about calling, courage, stewardship, culture, and the decisions leaders rarely process alone.</p>
      <a class="btn btn-secondary" href="/collective/">Explore leadership stories</a>
    </div>
    <div class="story-list" aria-label="Kingdom Factor story themes">
      <article>
        <span>01</span>
        <h3>Faith in business</h3>
        <p>Conversations about integrating conviction into decisions, culture, people, and growth.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Leadership under pressure</h3>
        <p>Stories for owners carrying risk, responsibility, conflict, and stewardship.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Marketplace ministry</h3>
        <p>Practical examples of serving people well while building a healthy business.</p>
      </article>
    </div>
  </section>

  <section class="faq-section closing-faq" aria-labelledby="homepage-faq-title">
    <div class="faq-intro">
      <p class="eyebrow">Practical questions</p>
      <h2 id="homepage-faq-title">A few things Christian owners and leaders usually ask first.</h2>
      <p>Serious leaders can get clear context without pressure. These questions help you discern which path — peer advisory, the Kingdom Culture Intensive, executive coaching, or marketplace ministry consulting — is the right next step for your season.</p>
    </div>
    <div class="faq-list compact-faq">
      <details open>
        <summary>Do I need to own a business to benefit from these offerings?</summary>
        <p>Most of our offerings are designed for business owners, executives, and senior leaders who carry real responsibility for people, profit, and culture. However, bi-vocational leaders and emerging leaders with strategic influence can also benefit, especially if they are serious about integrating faith and work.</p>
      </details>
      <details>
        <summary>Are these programs explicitly Christian?</summary>
        <p>Yes. Everything we do is rooted in Scripture, prayer, and a clear commitment to following Jesus. We welcome people into environments where Christ-centered leadership, Kingdom vision, and spiritual formation are central, not added on as an afterthought.</p>
      </details>
      <details>
        <summary>How do I decide between a peer advisory group, the Kingdom Culture Intensive, executive coaching, and marketplace ministry consulting?</summary>
        <p>Think of it this way:</p>
        <ul class="faq-bullets">
          <li>Choose a <strong>Peer Advisory Group</strong> when the primary 'project' is our shared journey — you want to walk with other Christian leaders who are also listening to God, solving complex problems, and holding one another accountable over time.</li>
          <li>Choose the <strong>Kingdom Culture Intensive</strong> if you're ready for a focused 90-day push to align your faith, culture, and leadership in a practical, measurable way.</li>
          <li>Choose <strong>Executive Coaching</strong> when the primary 'project' is you — your soul, your leadership, and your discernment — and you want a confidential, faith-anchored space to grow and decide wisely.</li>
          <li>Choose <strong>Marketplace Ministry Consulting</strong> when the primary 'project' is your organization — its culture, strategy, and impact — and you want to intentionally shape your business as ministry in the marketplace.</li>
        </ul>
      </details>
      <details>
        <summary>How do I take the next step?</summary>
        <p>Your simplest next step is to request a fit conversation with Dr. Lybarger or Jim. From there, we'll help you discern which path — peer advisory, the Kingdom Culture Intensive, executive coaching, or marketplace ministry consulting — is the best next faithful step for you and your business.</p>
      </details>
      <details>
        <summary>Do I have to be a Christian to participate?</summary>
        <p>No. We simply ask that you sign our statement of faith to acknowledge that our teaching, philosophy, values, and practices are grounded in a faith-based approach to leadership in the marketplace. If you are comfortable with that, you are welcome to participate.</p>
      </details>
      <details>
        <summary>Are Kingdom Factor peer advisory groups confidential?</summary>
        <p>Yes. Confidentiality is a core part of the experience, creating the trust leaders need to share openly and grow together.</p>
      </details>
      <details>
        <summary>How do I get started?</summary>
        <p>Getting started is simple: connect with us through the website, and we'll help you explore whether Kingdom Factor is the right fit for you.</p>
      </details>
    </div>
  </section>

  <CTA title="Next step" text="Find the right path for the season you are leading through. Start with a fit conversation. We will help you discern whether to begin with a peer advisory group, engage in executive coaching, explore marketplace ministry resources, or pursue a strategic combination of these options to move you toward your goals." />
</Base>
