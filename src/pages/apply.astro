---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
---
<Base title="Apply" description="Request a Kingdom Factor fit conversation. Form and calendar routing are pending approval." canonical="/apply/">
  <PageHero eyebrow="Fit conversation" title="Ensure you're in the room where wisdom surrounds you." text="A fit conversation helps you clarify your next step, whether that's a peer advisory group, executive coaching, marketplace ministry resources, or another path that best supports the decisions you are carrying." primary={{ label: "Email/form routing pending", href: "/contact/" }} secondary={{ label: "Compare the two lanes", href: "/" }} />
  <section class="content-section">
    <div class="form-placeholder">
      <p class="eyebrow">Approval-gated form</p>
      <h2>Application fields pending confirmation</h2>
      <p>Suggested fields: name, email, company, role, business stage, preferred lane, current leadership challenge, webinar interest, and consent to be contacted. Do not connect submission routing until Chris approves the destination.</p>
    </div>
  </section>
</Base>
