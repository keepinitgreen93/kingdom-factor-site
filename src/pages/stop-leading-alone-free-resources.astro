  {
    video: "Video 4",
    keyword: "CLARITY",
    title: "Decision Clarity Checklist",
    id: "decision-clarity-checklist",
    description: "Slow down a high-stakes decision until calling, character, people, and next steps are clear.",
  },
  {
    video: "Video 7",
    keyword: "TEAM",
    title: "Team Alignment Assessment",
    id: "team-alignment-assessment",
    description: "Check whether your team has the clarity, trust, and rhythm needed to move together.",
