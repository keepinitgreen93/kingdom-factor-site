      "Faith-integrated counsel: Scripture, prayer, and practical leadership wisdom belong together.",
      "Grace and truth: People encourage me and challenge me.",
      "Accountability: Commitments are remembered and followed up.",
    ],
    prompts: [
      "Where do I currently go when the decision is complex?",
      "Who can ask me the questions I may avoid asking myself?",
      "Where do I need counsel that is both faithful and practical?",
      "What would change if I had a wiser room this quarter?",
    ],
    nextStep:
      "If you do not have this kind of room, start a fit conversation about peer advisory, coaching, or consulting.",
  },
  {
    eyebrow: "Resource 07 · Comment keyword RESET",
    title: "The Resilience Reset 5-Day Challenge",
    id: "the-resilience-reset-5-day-challenge",
    bestFor: "Depleted leaders who have been calling exhaustion faithfulness.",
    purpose: "Use one small practice each day to rebuild margin and tell the truth about what you carry.",
    checklistTitle: "Five-day reset rhythm.",
    checklist: [
      "Day 1 — Name the weight: Write down what you are carrying that most people do not see.",
      "Day 2 — Restore one rhythm: Protect one short block for prayer, quiet, sleep, movement, or Scripture.",
      "Day 3 — Tell the truth: Share one honest sentence with a trusted person.",
      "Day 4 — Receive support: Ask one person for counsel, prayer, or practical help.",
      "Day 5 — Take one faithful step: Choose the next small act of stewardship instead of trying to fix everything.",
    ],
    prompts: [
      "What am I calling faithfulness that may actually be depletion?",
      "Where do I need to stop performing strength?",
      "What rhythm would help me lead with more peace and presence?",
      "Who should not have to wait until I am in crisis to hear the truth?",
    ],
    nextStep:
      "At the end of five days, decide what support you need for the next thirty days. Do not return to carrying it all alone.",
  },
];
---
<Base title={pageTitle} description={pageDescription} canonical={pagePath}>
  <Schema
    type="WebPage"
    title={pageTitle}
    description={pageDescription}
    path={pagePath}
    breadcrumbs={[{ name: "Home", item: "/" }, { name: "Stop Leading Alone Free Resources", item: pagePath }]}
  />

  <section class="resource-hero" aria-labelledby="free-resources-title">
    <div class="hero-copy">
      <p class="eyebrow">Free resources from the Stop Leading Alone campaign</p>
      <h1 id="free-resources-title">Stop Leading Alone free resources</h1>
      <p>
        Use these printable tools to name what you are carrying, think clearly about hard decisions, align your team, and take one faithful next step toward a wiser room.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#campaign-resource-links">Find your resource</a>
        <a class="btn btn-secondary" href={amazonUrl} target="_blank" rel="noopener">Buy the book</a>
      </div>
    </div>
    <aside class="hero-resource-card" aria-label="Stop Leading Alone resource summary">
      <img src="/images/brand/kf-pdc-lead-better-together.png" alt="Purpose Driven Consulting, LLC and Kingdom Factor — Lead Better Together" width="2172" height="724" />
      <h2>Real conversations. Real support. Real leadership growth.</h2>
      <p>
        Each section has its own anchor, so LinkedIn and Facebook replies can send people directly to the resource they requested.
      </p>
      <div class="mini-link-list">
        <a href={johnConsultUrl} target="_blank" rel="noopener">Schedule with John</a>
        <a href={jimConsultUrl} target="_blank" rel="noopener">Schedule with Jim</a>
        <a href={pageUrl}>{pageUrl}</a>
      </div>
    </aside>
  </section>

  <section id="covenant-workbook" class="featured-free-resource" aria-labelledby="covenant-workbook-title">
    <div class="featured-resource-copy">
      <p class="eyebrow">Free resource · Companion workbook</p>
      <h2 id="covenant-workbook-title">The Covenant Workbook</h2>
      <p>
        The companion workbook to Dr. John S. Lybarger's book,
        <cite>Covenant, Not Contract: Building a Marriage That Lasts</cite>.
      </p>
      <a class="btn btn-primary" href={covenantWorkbookUrl} target="_blank" rel="noopener">Open the free workbook</a>
    </div>
    <div class="featured-resource-detail" aria-label="Workbook details">
      <span>Six-week journey</span>
      <strong>Premarital counseling workbook</strong>
      <small>Interactive, printable, and designed to save your progress in your browser.</small>
    </div>
  </section>

  <section id="campaign-resource-links" class="shortcut-section" aria-labelledby="shortcut-title">
    <div class="section-header center">
      <p class="eyebrow">Campaign resource links</p>
      <h2 id="shortcut-title">Choose the resource that matches the comment keyword.</h2>
      <p>
        These anchors match the Stop Leading Alone video campaign reply workflow. Visitors can print one resource or print the whole page.
      </p>
    </div>
    <div class="shortcut-grid">
      {campaignLinks.map((item) => (
        <a class="shortcut-card" href={`#${item.id}`}>
          <span>{item.video} · {item.keyword}</span>
          <strong>{item.title}</strong>
          <small>{item.description}</small>
        </a>
      ))}
    </div>
  </section>

  <section id="resources" class="resources-section" aria-label="Printable resources">
    {resourceSections.map((resource, index) => (
      <article class="resource-card" id={resource.id} data-resource-title={resource.title}>
        <div class="resource-card-head">
          <div>
            <p class="eyebrow">{resource.eyebrow}</p>
            <h2>{resource.title}</h2>
          </div>
          <button class="print-resource-button" type="button" data-print-resource={resource.id}>Print this resource</button>
        </div>

        <div class="resource-intro-grid">
          <p><strong>Purpose:</strong> {resource.purpose}</p>
          <p><strong>Best for:</strong> {resource.bestFor}</p>
        </div>

        <section class="tool-panel" aria-labelledby={`${resource.id}-checklist-title`}>
          <h3 id={`${resource.id}-checklist-title`}>{resource.checklistTitle}</h3>
          <div class="checklist-grid">
            {resource.checklist.map((item, itemIndex) => (
              <label>
                <input class="resource-input" type="checkbox" data-save-key={`${resource.id}-check-${itemIndex}`} />
                <span>{item}</span>
              </label>
            ))}
          </div>
        </section>

        <section class="tool-panel" aria-labelledby={`${resource.id}-prompts-title`}>
          <h3 id={`${resource.id}-prompts-title`}>Reflection notes</h3>
          <div class="prompt-grid">
            {resource.prompts.map((prompt, promptIndex) => (
              <label class="field">
                <span>{prompt}</span>
                <textarea class="resource-input" rows="3" data-save-key={`${resource.id}-prompt-${promptIndex}`}></textarea>
              </label>
            ))}
          </div>
        </section>

        <section class="next-step-panel" aria-labelledby={`${resource.id}-next-step-title`}>
          <div>
            <p class="eyebrow">Next faithful step</p>
            <h3 id={`${resource.id}-next-step-title`}>{resource.nextStep}</h3>
          </div>
          <div class="next-step-actions">
            <a class="btn btn-primary" href={index === 6 ? johnConsultUrl : johnConsultUrl} target="_blank" rel="noopener">Schedule with John</a>
            <a class="btn btn-secondary" href={jimConsultUrl} target="_blank" rel="noopener">Schedule with Jim</a>
          </div>
        </section>
      </article>
    ))}
  </section>

  <section class="share-section" aria-labelledby="share-title">
    <div>
      <p class="eyebrow">For campaign replies</p>
      <h2 id="share-title">Direct anchor links</h2>
      <p>Use these links in approved LinkedIn and Facebook replies after the page is live.</p>
    </div>
    <div class="share-link-table">
      {campaignLinks.map((item) => (
        <p><strong>{item.keyword}</strong> <a href={`${pagePath}#${item.id}`}>{pagePath}#{item.id}</a></p>
      ))}
    </div>
  </section>

  <CTA
    title="Ready for a wiser room?"
    text="If one of these resources named what you are carrying, take the next faithful step. A fit conversation can help you discern whether peer advisory, executive coaching, or consulting is the right path for this season."
  />
</Base>

<script is:inline>
  (() => {
    const storagePrefix = "stop-leading-alone-free-resources:";

    function storageKey(input) {
      return `${storagePrefix}${input.dataset.saveKey || input.name || input.id}`;
    }

    function restoreInput(input) {
      const saved = window.localStorage.getItem(storageKey(input));
      if (saved === null) return;
      if (input.type === "checkbox") {
        input.checked = saved === "true";
        return;
      }
      input.value = saved;
    }

    function saveInput(input) {
      if (input.type === "checkbox") {
        window.localStorage.setItem(storageKey(input), String(input.checked));
        return;
      }
      window.localStorage.setItem(storageKey(input), input.value);
    }

    function printResource(id) {
      const resources = [...document.querySelectorAll(".resource-card")];
      resources.forEach((resource) => resource.classList.toggle("print-hidden", resource.id !== id));
      window.print();
      window.setTimeout(() => resources.forEach((resource) => resource.classList.remove("print-hidden")), 500);
    }

    document.querySelectorAll(".resource-input").forEach((input) => {
      restoreInput(input);
      input.addEventListener(input.type === "checkbox" ? "change" : "input", () => saveInput(input));
    });

    document.querySelectorAll("[data-print-resource]").forEach((button) => {
      button.addEventListener("click", () => printResource(button.dataset.printResource));
    });
  })();
</script>

<style>
