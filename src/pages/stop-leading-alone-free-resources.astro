const covenantWorkbookUrl = "/resources/the-covenant-workbook.html";

const campaignLinks = [
  {
    video: "Video 1",
    keyword: "ALONE",
    title: "The 5 Signs You're Leading Alone",
    id: "the-5-signs-youre-leading-alone",
    description: "Name the warning signs that leadership weight has become too private.",
