    border-radius: 34px;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    box-shadow: 0 24px 70px rgba(64, 32, 22, 0.12);
  }

  .hero-resource-card img {
    display: block;
    width: min(360px, 100%);
    margin-bottom: clamp(1.4rem, 3vw, 2rem);
  }

  .hero-resource-card h2 {
    color: var(--burgundy-dark);
    margin-bottom: 0.8rem;
  }

