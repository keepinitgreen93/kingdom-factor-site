    eyebrow: "Resource 01 · Comment keyword ALONE",
    title: "The 5 Signs You're Leading Alone",
    id: "the-5-signs-youre-leading-alone",
    bestFor: "Leaders who look strong on the outside and still carry too much alone.",
    purpose: "Use this quick check to name where isolation may be shaping your leadership.",
    checklistTitle: "Check the signs that fit your current season.",
    checklist: [
