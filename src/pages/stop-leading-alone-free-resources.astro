  .shortcut-section .section-header p,
  .share-section p {
    color: #5f524b;
  }

  .mini-link-list {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.35rem;
  }

  .mini-link-list a {
    display: block;
    overflow-wrap: anywhere;
