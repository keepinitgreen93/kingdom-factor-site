      "Trust: People can tell the truth without fear or image management.",
      "Decisions: We know how decisions are made and who needs to be in the room.",
      "Values: Our daily behavior reflects what we say we believe.",
    ],
    prompts: [
      "Where is the team most aligned right now?",
      "Where is drift showing up first?",
      "What conversation have we delayed?",
      "What one rhythm would help this team move together?",
    ],
    nextStep:
      "Pick one alignment gap and schedule a direct, respectful conversation with the people closest to it.",
  },
  {
    eyebrow: "Resource 04 · Comment keyword SILOS",
    title: "5 Questions to Break Down Silos",
    id: "five-questions-to-break-down-silos",
    bestFor: "Teams or departments that are working hard and not working together.",
    purpose: "Use these questions to shift from blame to shared ownership.",
    checklistTitle: "Ask these five questions in a leadership meeting.",
    checklist: [
      "What information is not moving across the organization quickly enough?",
      "Where have we optimized one area while weakening the whole?",
      "Which decision rights or handoffs are unclear?",
      "What shared outcome should pull us back together?",
      "What rhythm will keep the right people in the same conversation?",
    ],
    prompts: [
      "Which silo is creating the greatest cost right now?",
      "What has leadership modeled that may have reinforced it?",
      "Who needs to be invited into the next conversation?",
      "What one handoff or meeting rhythm should change first?",
    ],
    nextStep:
      "Choose one shared outcome and gather the leaders who must own it together.",
  },
  {
    eyebrow: "Resource 05 · Comment keyword CALLING",
    title: "The Calling Reflection Guide",
    id: "the-calling-reflection-guide",
    bestFor: "Leaders who have built something meaningful and want to ensure it reflects their calling.",
    purpose: "Use these prompts to reconnect success, strategy, and stewardship.",
    checklistTitle: "Reflect honestly before changing direction or doubling down.",
    checklist: [
      "What work has God clearly placed in my hand right now?",
      "Where does my current strategy reflect that calling?",
      "Where does my current strategy compete with that calling?",
      "What fruit am I hoping this work produces in people, culture, and legacy?",
      "What support do I need to lead this calling faithfully?",
    ],
    prompts: [
      "What am I building that feels aligned with my calling?",
      "What am I building that feels impressive and not fully faithful?",
      "Where have I confused growth with obedience?",
      "What would the next faithful step look like?",
