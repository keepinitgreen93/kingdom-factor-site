  {
    video: "Video 8",
    keyword: "SILOS",
    title: "5 Questions to Break Down Silos",
    id: "five-questions-to-break-down-silos",
    description: "Use five leadership questions to start rebuilding communication across teams.",
  },
  {
    video: "Video 10",
    keyword: "CALLING",
    title: "The Calling Reflection Guide",
    id: "the-calling-reflection-guide",
