  :global(.resources-section.kf-reveal),
  :global(.share-section.kf-reveal),
  :global(.shortcut-section .section-header.kf-reveal),
  :global(.cta-band.kf-reveal) {
    opacity: 1 !important;
    transform: none !important;
  }

  .resource-hero {
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(3.5rem, 7vw, 7rem) clamp(1rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .resource-hero h1 {
    max-width: 14ch;
  }

  .resource-hero .hero-copy > p:not(.eyebrow) {
    max-width: 64ch;
    color: #504741;
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.65;
    margin-top: 1.25rem;
  }

  .hero-resource-card {
    background:
      radial-gradient(circle at 18% 12%, rgba(213, 178, 111, 0.22), transparent 34%),
