---
interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  signupFormUrl?: string;
  signupTitle?: string;
  signupText?: string;
}
const {
  eyebrow = "Next step",
  title = "Next step",
  text = "Start with a complimentary fit conversation. We'll partner with you to discern your next best step — whether it's peer advisory group membership, executive coaching, marketplace ministry exploration, or a customized combination.",
  primaryLabel = "Request a fit conversation",
  primaryHref = "/apply/",
  secondaryLabel = "Explore peer advisory",
  secondaryHref = "/peer-advisory-groups/",
  signupFormUrl,
  signupTitle = "Get leadership insights by email",
  signupText = "Sign up for news, practical guidance, and updates from Dr. Lybarger and Purpose Driven Consulting.",
} = Astro.props;
---
<section class:list={["cta-band", { "cta-band--with-signup": signupFormUrl }]}>
  <div class="cta-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
  <div class="cta-actions">
    <a class="btn btn-light" href={primaryHref}>{primaryLabel}</a>
    <a class="btn btn-outline-light" href={secondaryHref}>{secondaryLabel}</a>
  </div>
  {signupFormUrl && (
    <aside class="cta-signup" aria-labelledby="cta-signup-title">
      <div class="cta-signup-copy">
        <p class="eyebrow">Stay connected</p>
        <h3 id="cta-signup-title">{signupTitle}</h3>
        <p>{signupText}</p>
      </div>
      <iframe
        src={signupFormUrl}
        title="Sign up for email updates from Purpose Driven Consulting"
        class="cta-signup-frame"
        loading="lazy"
      ></iframe>
    </aside>
  )}
</section>

<style>
  .cta-band--with-signup {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(380px, 1.18fr);
    grid-template-areas:
      "copy signup"
      "actions signup";
    align-items: start;
    gap: 1.25rem clamp(2rem, 5vw, 4.5rem);
  }
  .cta-band--with-signup .cta-copy { grid-area: copy; }
  .cta-band--with-signup .cta-actions { grid-area: actions; margin-top: 0.75rem; }
  .cta-signup {
    grid-area: signup;
    min-width: 0;
    padding: clamp(1.1rem, 2vw, 1.6rem);
    background: rgba(255, 250, 242, 0.98);
    border: 1px solid rgba(255, 250, 242, 0.42);
    border-radius: 24px;
    box-shadow: 0 22px 55px rgba(30, 5, 8, 0.24);
    color: var(--burgundy-dark, #4a0f15);
  }
  .cta-signup-copy h3 {
    margin: 0.3rem 0 0.65rem;
    font-size: clamp(1.45rem, 2.2vw, 2rem);
    line-height: 1.18;
  }
  .cta-band .cta-signup-copy > p:last-child {
    margin: 0;
    color: rgba(81, 70, 63, 0.9);
  }
  .cta-signup-frame {
    display: block;
    width: 100%;
    height: 920px;
    margin-top: 1rem;
    border: 0;
    border-radius: 16px;
    background: #fff;
  }
  @media (max-width: 820px) {
    .cta-band--with-signup {
      grid-template-columns: 1fr;
      grid-template-areas:
        "copy"
        "actions"
        "signup";
    }
    .cta-signup { margin-top: 1rem; }
    .cta-signup-frame { height: 1020px; }
  }
</style>
