---
import { nav } from "../lib/site";
---
<footer class="site-footer">
  <div class="footer-grid refined-footer-grid">
    <div class="footer-intro">
      <img class="footer-logo footer-logo-wide" src="/images/brand/kf-pdc-lead-better-together.png" alt="Purpose Driven Consulting, LLC and Kingdom Factor — Lead Better Together" width="2172" height="724" />
      <p class="footer-tagline">Lead with wisdom. Never lead alone.</p>
      <p>Peer advisory, executive coaching, and marketplace ministry for Christian business owners and leaders who want wisdom in the room.</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {nav.slice(0, 4).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2>Connect</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/blog/">Blog & resources</a></li>
        <li><a href="/newsletter/">Monthly newsletter</a></li>
        <li><a href="/apply/">Request a fit conversation</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/books/">Books & resources</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Kingdom Factor.</span>
    <span class="legal-links">
      <a href="/privacy-policy/" data-astro-reload>Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href="/terms/" data-astro-reload>Terms of Service</a>
      <span aria-hidden="true">·</span>
      <a href="/disclaimer/" data-astro-reload>Disclaimer</a>
    </span>
  </div>
</footer>

<style>
  .footer-logo-wide {
    width: min(520px, 100%);
    height: auto;
    padding: 0;
    background: transparent;
    border-radius: 18px;
    object-fit: contain;
  }
  .footer-tagline {
    font-family: "Libre Baskerville", Georgia, serif;
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--gold, #d5b26f);
    margin: 0.65rem 0 0.9rem;
    max-width: 22ch;
  }
  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: flex-end;
  }
  @media (max-width: 720px) {
    .legal-links {
      justify-content: flex-start;
    }
  }
</style>
